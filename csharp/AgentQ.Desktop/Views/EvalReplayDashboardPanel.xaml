<UserControl x:Class="AgentQ.Desktop.Views.EvalReplayDashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Top"
                Content="{Binding EvalDashboardRefreshText}"
                Height="28"
                Margin="0,0,0,8"
                Click="Refresh_OnClick" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding EvalDashboardHelpText}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <Border DockPanel.Dock="Top"
                Background="#0E151E"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding EvalDashboardSummary}"
                           Foreground="{DynamicResource TextMain}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding EvalDashboardUpdatedText}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="10"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Metrics"
                           Foreground="{DynamicResource TextMain}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding EvalDashboardMetrics}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Findings"
                           Foreground="{DynamicResource TextMain}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding EvalDashboardFindings}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#141D28"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7"
                                    Margin="0,0,0,6">
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMain}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Failure Fingerprints"
                           Foreground="{DynamicResource TextMain}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding EvalDashboardFailureFingerprints}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource Warning}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Latest Replay"
                           Foreground="{DynamicResource TextMain}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding EvalDashboardReplayEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
