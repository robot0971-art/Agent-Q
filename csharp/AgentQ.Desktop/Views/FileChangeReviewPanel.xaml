<UserControl x:Class="AgentQ.Desktop.Views.FileChangeReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#0E151E"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding PendingReviewVerificationText}"
                           Foreground="{DynamicResource Accent}"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding ReviewWorkflowText}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Button DockPanel.Dock="Top"
                Content="Approve all &amp; verify"
                Height="28"
                Margin="0,0,0,8"
                Click="ApproveAutoFixAndVerify_OnClick"
                IsEnabled="{Binding CanApproveAllAndVerify}" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListBox x:Name="FileChangesList"
                     ItemsSource="{Binding FileChanges}"
                     SelectedItem="{Binding SelectedFileChange, Mode=TwoWay}"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.PanningMode="VerticalOnly"
                     PreviewMouseWheel="SmoothScrollViewer_OnPreviewMouseWheel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0E151E"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding RelativePath}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"
                                               TextWrapping="Wrap" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Summary}"
                                               Foreground="{DynamicResource Warning}"
                                               FontSize="11"
                                               Margin="6,0,0,0" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding ChangedAtText}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ReviewStatusText}"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="11"
                                               Margin="8,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Row="1" Margin="0,8,0,6">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Approve"
                            Width="72"
                            Height="24"
                            Padding="0"
                            FontSize="11"
                            Click="ApproveSelectedFileChange_OnClick" />
                    <Button Content="Needs edit"
                            Width="82"
                            Height="24"
                            Padding="0"
                            FontSize="11"
                            Margin="6,0,0,0"
                            Click="NeedsEditSelectedFileChange_OnClick" />
                    <Button Content="Revert"
                            Width="64"
                            Height="24"
                            Padding="0"
                            FontSize="11"
                            Margin="6,0,0,0"
                            Click="RevertSelectedFileChange_OnClick" />
                </WrapPanel>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedFileChange.RelativePath, TargetNullValue=Select a changed file}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedFileChange.SnapshotLabel}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="2"
                    Background="#0B1118"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseWheel="SmoothScrollViewer_OnPreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding SelectedFileChange.DiffLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,1">
                                    <TextBlock Text="{Binding Prefix}"
                                               Width="18"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{Binding Foreground}" />
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               Foreground="{Binding Foreground}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
