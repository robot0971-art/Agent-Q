<UserControl x:Class="AgentQ.Desktop.Views.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Margin="0,0,6,8">
        <StackPanel>
            <TextBlock Text="{Binding ProjectHeaderText}" Style="{DynamicResource PanelHeader}" Margin="0,0,0,10" />
            <TextBlock Text="{Binding ProjectFolderText}" Style="{DynamicResource LabelText}" />
            <TextBox Margin="0,0,0,8" Text="{Binding WorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding BrowseFolderText}" Click="BrowseWorkspace_OnClick" />
                <Button Grid.Column="2" Content="{Binding OpenFolderText}" Click="OpenWorkspace_OnClick" />
            </Grid>
            <Button Content="Analyze"
                    Height="26"
                    Margin="0,8,0,8"
                    Click="RefreshWorkspaceAnalysis_OnClick" />
            <Button Content="{Binding BuildEmbeddingIndexText}"
                    Height="26"
                    Margin="0,0,0,8"
                    Click="BuildEmbeddingIndex_OnClick" />
            <Border Background="#0E151E"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="{Binding WorkspaceAnalysisSummary}"
                               Foreground="{DynamicResource TextMain}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkspaceProjectType}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Framework" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkspaceFramework}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Git" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkspaceGitBranch}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkspaceStats}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="Commands" Style="{DynamicResource LabelText}" />
                    <ItemsControl ItemsSource="{Binding WorkspaceVerificationCommands}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource Accent}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Project map" Style="{DynamicResource LabelText}" />
                    <ItemsControl ItemsSource="{Binding WorkspaceProjectMap}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Key files" Style="{DynamicResource LabelText}" />
                    <ItemsControl ItemsSource="{Binding WorkspaceKeyFiles}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource Accent}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding WorkspaceHints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding WorkspaceAnalysisUpdatedText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Grid Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Save config" Click="SaveProjectConfig_OnClick" />
                <Button Grid.Column="2" Content="Load config" Click="LoadProjectConfig_OnClick" />
            </Grid>
            <TextBox Text="{Binding ProjectConfigText}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="10"
                     MinHeight="70"
                     MaxHeight="110"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </Border>
</UserControl>
