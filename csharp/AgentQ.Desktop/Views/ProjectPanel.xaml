<UserControl x:Class="AgentQ.Desktop.Views.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Margin="0,0,6,8">
        <StackPanel>
            <TextBlock Text="{Binding ProjectHeaderText}" Style="{DynamicResource PanelHeader}" Margin="0,0,0,10" />
            <TextBlock Text="{Binding ProjectFolderText}" Style="{DynamicResource LabelText}" />
            <TextBox Margin="0,0,0,8" Text="{Binding WorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding BrowseFolderText}" Click="BrowseWorkspace_OnClick" />
                <Button Grid.Column="2" Content="{Binding OpenFolderText}" Click="OpenWorkspace_OnClick" />
                <Button Grid.Column="4" Content="{Binding OpenVSCodeText}" Click="OpenWorkspaceInVSCode_OnClick" />
            </Grid>
            <Button Content="Analyze"
                    Height="34"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Padding="10,0"
                    Margin="0,10,0,8"
                    Click="RefreshWorkspaceAnalysis_OnClick" />
            <Button Content="{Binding BuildEmbeddingIndexText}"
                    Height="34"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Padding="10,0"
                    Margin="0,0,0,8"
                    Click="BuildEmbeddingIndex_OnClick" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Copy report"
                        Height="30"
                        Padding="10,0"
                        Click="CopyAnalysisReport_OnClick" />
                <Button Grid.Column="2"
                        Content="Save report"
                        Height="30"
                        Padding="10,0"
                        Click="SaveAnalysisReport_OnClick" />
            </Grid>
            <Border Background="#0E151E"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    DataContext="{Binding Project}">
                <StackPanel>
                    <TextBlock Text="{Binding AnalysisSummary}"
                               Foreground="{DynamicResource TextMain}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <Border Background="#09121D"
                            BorderBrush="{Binding HealthAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="7"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Border DockPanel.Dock="Right"
                                        Background="#13202D"
                                        BorderBrush="{Binding HealthAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="6,0,0,0">
                                    <TextBlock Text="{Binding HealthText}"
                                               Foreground="{Binding HealthAccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="Project dashboard"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="{Binding DashboardSummary}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <UniformGrid Columns="2">
                                <TextBlock Text="{Binding SymbolCountText}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           Margin="0,1,6,1" />
                                <TextBlock Text="{Binding DependencyCountText}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           Margin="0,1,0,1" />
                                <TextBlock Text="{Binding KeyFileCountText}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           Margin="0,1,6,1" />
                                <TextBlock Text="{Binding VerificationCommandCountText}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           Margin="0,1,0,1" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding ProjectType}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Framework" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding Framework}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Git" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding GitBranch}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats}" Foreground="{DynamicResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="Commands" Style="{DynamicResource LabelText}" />
                    <TextBlock Text="{Binding VerificationCommandsEmptyText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerificationCommands.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding VerificationCommands}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource Accent}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Project map" Style="{DynamicResource LabelText}" />
                    <TextBlock Text="{Binding ProjectMapEmptyText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProjectMap.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ProjectMap}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Key symbols" Style="{DynamicResource LabelText}" />
                    <TextBlock Text="{Binding KeySymbolsEmptyText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeySymbols.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding KeySymbols}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Key dependencies" Style="{DynamicResource LabelText}" />
                    <TextBlock Text="{Binding KeyDependenciesEmptyText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeyDependencies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding KeyDependencies}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Key files" Style="{DynamicResource LabelText}" />
                    <TextBlock Text="{Binding KeyFilesEmptyText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeyFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding KeyFiles}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource Accent}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Hints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AnalysisUpdatedText}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Grid Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Save config" Click="SaveProjectConfig_OnClick" />
                <Button Grid.Column="2" Content="Load config" Click="LoadProjectConfig_OnClick" />
            </Grid>
            <TextBox Text="{Binding ProjectConfigText}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="10"
                     MinHeight="70"
                     MaxHeight="110"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </Border>
</UserControl>
