<UserControl x:Class="AgentQ.Desktop.Views.VerificationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Top"
                Content="Fix failure"
                Height="28"
                Margin="0,0,0,8"
                Click="FixFailure_OnClick"
                IsEnabled="{Binding CanFixLastVerificationFailure}" />
        <Button DockPanel.Dock="Top"
                Content="Auto fix x3"
                Height="28"
                Margin="0,0,0,8"
                Click="AutoFix_OnClick"
                IsEnabled="{Binding CanFixLastVerificationFailure}" />
        <ItemsControl DockPanel.Dock="Top"
                      ItemsSource="{Binding VerificationResults}"
                      Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0E151E"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextWrapping="Wrap" />
                            <Border Grid.Column="1"
                                    Background="{Binding BadgeBackground}"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{Binding AccentBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="10" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Command}"
                                       Foreground="{DynamicResource Accent}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,3" />
                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Summary}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <DockPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding CreatedAtText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Grid.Row="4"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding OutputPreview}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox ItemsSource="{Binding VerificationPlans}"
                 FontSize="12"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0E151E"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="Run"
                                    Width="48"
                                    Height="24"
                                    Padding="0"
                                    FontSize="11"
                                    Click="Run_OnClick"
                                    IsEnabled="{Binding IsRunnable}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Command}" Foreground="{DynamicResource Accent}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,4" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Reason}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

