<UserControl x:Class="AgentQ.Desktop.Views.PlanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Create plan"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{DynamicResource PlanButton}"
                    Click="CreatePlan_OnClick" />
            <Button Content="Continue next"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{DynamicResource PlanButton}"
                    Click="ContinuePlanItem_OnClick" />
            <Button Content="Mark done"
                    Grid.Row="0"
                    Grid.Column="2"
                    Style="{DynamicResource PlanButton}"
                    Margin="0,0,0,6"
                    Click="MarkPlanItemDone_OnClick" />
            <Button Content="Save checkpoint"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{DynamicResource PlanButton}"
                    Click="SaveCheckpoint_OnClick" />
            <Button Content="Load"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{DynamicResource PlanButton}"
                    Click="LoadCheckpoint_OnClick" />
            <Button Content="Resume"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{DynamicResource PlanButton}"
                    Margin="0,0,0,6"
                    Click="ResumeCheckpoint_OnClick"
                    IsEnabled="{Binding CanResumeCheckpoint}" />
            <Button Content="Plan+run"
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{DynamicResource PlanButton}"
                    Click="PlanAndRun_OnClick" />
            <Button Content="Done+next"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{DynamicResource PlanButton}"
                    Click="MarkDoneAndContinue_OnClick" />
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="105" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#0E151E"
                    BorderBrush="{Binding PlanEvidenceAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <Border DockPanel.Dock="Right"
                                Background="#13202D"
                                BorderBrush="{Binding PlanEvidenceAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="8,0,0,0">
                            <TextBlock Text="Evidence"
                                       Foreground="{Binding PlanEvidenceAccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding PlanEvidenceStatusText}"
                                   Foreground="{DynamicResource TextMain}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding PlanEvidenceSummary}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding PlanItems}"
                     SelectedItem="{Binding SelectedPlanItem, Mode=TwoWay}"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0E151E"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"
                                               TextWrapping="Wrap" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding StatusText}"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="11"
                                               Margin="6,0,0,0" />
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2"
                       Text="Checkpoint"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"
                       Margin="0,0,0,4" />
            <TextBox Grid.Row="3"
                     Text="{Binding LatestCheckpointText}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</UserControl>
