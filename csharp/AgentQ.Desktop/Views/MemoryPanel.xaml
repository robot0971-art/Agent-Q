<UserControl x:Class="AgentQ.Desktop.Views.MemoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="{Binding SaveSummaryText}"
                    Width="96"
                    Height="26"
                    Padding="0"
                    FontSize="11"
                    Margin="0,0,6,0"
                    Click="SaveSessionSummary_OnClick" />
            <Button Content="{Binding LoadText}"
                    Width="54"
                    Height="26"
                    Padding="0"
                    FontSize="11"
                    Margin="0,0,6,0"
                    Click="LoadSessionSummary_OnClick" />
            <Button Content="{Binding ResumeText}"
                    Width="62"
                    Height="26"
                    Padding="0"
                    FontSize="11"
                    Click="ResumeSessionSummary_OnClick"
                    IsEnabled="{Binding CanResumeSessionSummary}" />
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="210" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="210" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding LearningCandidatesText}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="1"
                       Text="{Binding LearningCandidatesHelpText}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding PendingMemoryLessons}"
                     SelectedItem="{Binding SelectedPendingMemoryLesson, Mode=TwoWay}"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111C28"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,0,0,8">
                            <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource TextMain}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Content}"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                <Button Content="{Binding SaveLessonText}"
                        Width="86"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="SaveSelectedLesson_OnClick" />
                <Button Content="{Binding DismissText}"
                        Width="66"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Click="DismissSelectedLesson_OnClick" />
            </WrapPanel>
            <TextBlock Grid.Row="4"
                       Text="{Binding SavedMemoryText}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       Margin="0,0,0,4" />
            <ListBox Grid.Row="5"
                     ItemsSource="{Binding SavedMemoryLessons}"
                     SelectedItem="{Binding SelectedSavedMemoryLesson, Mode=TwoWay}"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111C28"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource TextMain}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Content}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LastUsedAt, StringFormat=Last used: {0:g}}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="6" Margin="0,0,0,8">
                <Button Content="{Binding RefreshText}"
                        Width="70"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="RefreshSavedMemory_OnClick" />
                <Button Content="Preview GC"
                        Width="84"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="PreviewMemoryCleanup_OnClick" />
                <Button Content="Compact"
                        Width="68"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="CompactMemory_OnClick" />
                <Button Content="{Binding DisableText}"
                        Width="66"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Margin="0,0,6,0"
                        Click="DisableSavedMemory_OnClick" />
                <Button Content="{Binding DeleteText}"
                        Width="54"
                        Height="24"
                        Padding="0"
                        FontSize="11"
                        Click="DeleteSavedMemory_OnClick" />
            </WrapPanel>
            <TextBlock Grid.Row="7"
                       Text="{Binding MemoryGcPreviewText}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <TextBlock Grid.Row="8"
                       Text="{Binding SessionSummaryText}"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="11"
                       Margin="0,0,0,4" />
            <TextBox Grid.Row="9"
                     Text="{Binding LatestSessionSummaryText}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</UserControl>
