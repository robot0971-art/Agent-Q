<UserControl x:Class="AgentQ.Desktop.Views.RunTimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding EvidenceTrailHelpText}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <ListBox ItemsSource="{Binding RunSteps}"
                 FontSize="12"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CreatedAtText}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Margin="0,7,8,0" />
                        <Grid Grid.Column="1">
                            <Border Width="2"
                                    Background="#263342"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,-10" />
                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{Binding AccentBrush}"
                                     Stroke="#0A1017"
                                     StrokeThickness="2"
                                     VerticalAlignment="Top"
                                     Margin="0,9,0,0" />
                        </Grid>
                        <Border Grid.Column="2"
                                Background="#0E151E"
                                BorderBrush="{Binding AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <Border DockPanel.Dock="Right"
                                            Background="{Binding BadgeBackground}"
                                            BorderBrush="{Binding AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding TimelineLabel}"
                                                   Foreground="{Binding AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"
                                               TextWrapping="WrapWithOverflow" />
                                </DockPanel>
                                <TextBlock Text="{Binding TimelineDetail}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
