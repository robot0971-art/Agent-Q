<UserControl x:Class="AgentQ.Desktop.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,6,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0E151E"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0">
                <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                    <Border Background="#162131"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4">
                        <TextBlock Text="새 대화" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <ListBox x:Name="MessagesList"
                     Grid.Row="1"
                     ItemsSource="{Binding Messages}"
                     Padding="10"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.PanningMode="VerticalOnly"
                     ScrollViewer.ScrollChanged="MessagesList_OnScrollChanged"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12"
                                Margin="0,0,0,10"
                                Background="{DynamicResource PanelAltBg}"
                                MaxWidth="{Binding ActualWidth, ElementName=MessagesList}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource AccentSoft}"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="A"
                                                   Foreground="#BFDBFE"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Role}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CreatedAtText}"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Text="{Binding Content}"
                                         TextWrapping="Wrap"
                                         FontSize="{Binding DataContext.DesktopFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         Foreground="{DynamicResource TextMain}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False"
                                         AcceptsReturn="True"
                                         PreviewMouseWheel="MessageTextBox_OnPreviewMouseWheel"
                                         TextChanged="MessageTextBox_OnTextChanged">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="복사" Command="ApplicationCommands.Copy" />
                                            <MenuItem Header="메시지 전체 복사" Click="CopyMessage_OnClick" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#132A44"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6"
                                                    ToolTip="{Binding Path}">
                                                <TextBlock Foreground="#93C5FD" FontSize="12">
                                                    <Run Text="{Binding Kind}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding FileName}" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="첨부 파일" Width="86" Height="28" Click="AttachFiles_OnClick" />
                    <Button Content="코드 블록" Width="86" Height="28" Margin="6,0,0,0" />
                    <Button Content="프로젝트 파일 추가" Width="124" Height="28" Margin="6,0,0,0" Click="BrowseWorkspace_OnClick" />
                    <Button Content="첨부 지우기" Width="92" Height="28" Margin="6,0,0,0" Click="ClearAttachments_OnClick" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox"
                             MinHeight="54"
                             MaxHeight="126"
                             AcceptsReturn="True"
                             FontSize="{Binding DesktopFontSize}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="InputBox_OnPreviewKeyDown"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2"
                            Content="Continue"
                            Margin="8,0,0,0"
                            Click="ContinueLastRun_OnClick"
                            IsEnabled="{Binding CanContinueLastRun}" />
                    <Button Grid.Column="3"
                            Content="Stop"
                            Margin="8,0,0,0"
                            Click="StopAgent_OnClick"
                            IsEnabled="{Binding IsBusy}" />
                    <Button Grid.Column="1"
                            Content="전송&#x0a;Ctrl+Enter"
                            Style="{DynamicResource PrimaryButton}"
                            Margin="8,0,0,0"
                            Click="Send_OnClick" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
