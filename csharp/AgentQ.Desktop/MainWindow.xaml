<Window x:Class="AgentQ.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AgentQ.Desktop.Views"
        Title="AgentQ Desktop"
        Height="760"
        Width="1180"
        MinHeight="660"
        MinWidth="1040"
        Background="#070C12"
        FontFamily="Segoe UI"
        Icon="Assets/app-icon.ico"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#0A1017" />
        <SolidColorBrush x:Key="PanelBg" Color="#101821" />
        <SolidColorBrush x:Key="PanelAltBg" Color="#16202B" />
        <SolidColorBrush x:Key="InputBg" Color="#0D151E" />
        <SolidColorBrush x:Key="InputText" Color="#E6EDF5" />
        <SolidColorBrush x:Key="InputBorder" Color="#2A3948" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#263342" />
        <SolidColorBrush x:Key="TextMain" Color="#EDF3F8" />
        <SolidColorBrush x:Key="TextMuted" Color="#B7C4D1" />
        <SolidColorBrush x:Key="Accent" Color="#5BA7FF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#173B5D" />
        <SolidColorBrush x:Key="Success" Color="#37D67A" />
        <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
        <SolidColorBrush x:Key="Danger" Color="#F87171" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="#2563EB" />
            <Setter Property="SelectionTextBrush" Value="White" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Background" Value="#0B1118" />
            <Setter Property="Foreground" Value="#5BA7FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="3,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb"
                                           Background="#4B6F92"
                                           BorderBrush="#6EA8E8"
                                           BorderThickness="1" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="14" />
                                <Setter Property="MinHeight" Value="14" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Background" Value="#5BA7FF" />
                                <Setter TargetName="ScrollThumb" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="#2563EB" />
            <Setter Property="SelectionTextBrush" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <Grid>
                                    <ContentPresenter Margin="8,0,28,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{StaticResource InputText}" />
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource TextMuted}"
                                          Width="8"
                                          Height="4"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#111C27"
                                        BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InputText}" />
            <Setter Property="Background" Value="#111C27" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{StaticResource InputText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1F3A56" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4F7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="#1C2A38" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PlanButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24364A" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B4F64" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#172433" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#708090" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#18222D" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#22303E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelAltBg}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1B2A39" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="#0B1118" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B1118"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" Background="#0D151E" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <Image Source="Assets/app-icon.png" Width="26" Height="26" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="AgentQ Desktop"
                           Foreground="{StaticResource TextMain}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="-" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_OnClick" />
                    <Button Content="□" Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_OnClick" />
                    <Button Content="×" Style="{StaticResource TitleBarButton}" Click="CloseWindow_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Background="#0B1118" LastChildFill="True">
            <Menu DockPanel.Dock="Left" Background="#0B1118" Foreground="{StaticResource TextMain}" BorderThickness="0" FontSize="12">
                <MenuItem Header="파일">
                    <MenuItem Header="프로젝트 폴더 선택" Click="BrowseWorkspace_OnClick" />
                    <MenuItem Header="첨부 추가" Click="AttachFiles_OnClick" />
                    <MenuItem Header="첨부 지우기" Click="ClearAttachments_OnClick" />
                    <Separator />
                    <MenuItem Header="종료" Click="Exit_OnClick" />
                </MenuItem>
                <MenuItem Header="편집">
                    <MenuItem Header="마지막 답변 복사" Click="CopyLastAssistantMessage_OnClick" />
                    <MenuItem Header="전체 대화 복사" Click="CopyConversation_OnClick" />
                    <MenuItem Header="대화 초기화" Click="ClearConversation_OnClick" />
                </MenuItem>
                <MenuItem Header="설정">
                    <MenuItem Header="설정 저장" Click="SaveSettings_OnClick" />
                </MenuItem>
                <MenuItem Header="보기">
                    <MenuItem Header="글자 크게" Click="IncreaseFontSize_OnClick" />
                    <MenuItem Header="글자 작게" Click="DecreaseFontSize_OnClick" />
                    <MenuItem Header="기본 글자 크기" Click="ResetFontSize_OnClick" />
                </MenuItem>
                <MenuItem Header="도움말">
                    <MenuItem Header="상태 보기" Click="ShowStatus_OnClick" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Grid.Row="2" Margin="4,6,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          Padding="0,0,4,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <views:SettingsPanel x:Name="SettingsPanelView" Grid.Row="0" />

                <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,8">
                    <StackPanel>
                        <TextBlock Text="프로젝트" Style="{StaticResource PanelHeader}" Margin="0,0,0,10" />
                        <TextBlock Text="프로젝트 폴더" Style="{StaticResource LabelText}" />
                        <TextBox Margin="0,0,0,8" Text="{Binding WorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="폴더 선택" Click="BrowseWorkspace_OnClick" />
                            <Button Grid.Column="2" Content="폴더 열기" Click="OpenWorkspace_OnClick" />
                        </Grid>
                        <Button Content="Analyze"
                                Height="26"
                                Margin="0,8,0,8"
                                Click="RefreshWorkspaceAnalysis_OnClick" />
                        <Border Background="#0E151E"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding WorkspaceAnalysisSummary}"
                                           Foreground="{StaticResource TextMain}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Type" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceProjectType}" Foreground="{StaticResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Framework" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceFramework}" Foreground="{StaticResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Git" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceGitBranch}" Foreground="{StaticResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceStats}" Foreground="{StaticResource TextMain}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="Commands" Style="{StaticResource LabelText}" />
                                <ItemsControl ItemsSource="{Binding WorkspaceVerificationCommands}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource Accent}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding WorkspaceHints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding WorkspaceAnalysisUpdatedText}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="10"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,8,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Save config" Click="SaveProjectConfig_OnClick" />
                            <Button Grid.Column="2" Content="Load config" Click="LoadProjectConfig_OnClick" />
                        </Grid>
                        <TextBox Text="{Binding ProjectConfigText}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="10"
                                 MinHeight="70"
                                 MaxHeight="110"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="도구 (Tools)" Style="{StaticResource PanelHeader}" />
                            <Button DockPanel.Dock="Right" Content="관리" Width="44" Height="24" Padding="0" FontSize="11" />
                        </DockPanel>
                        <StackPanel Grid.Row="1">
                            <CheckBox Content="read_file - 파일 내용을 읽습니다" IsChecked="True" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                            <CheckBox Content="write_file - 파일을 수정합니다" IsChecked="True" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                            <CheckBox Content="shell_execute - 명령을 실행합니다" IsChecked="True" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                            <CheckBox Content="search_files - 파일을 검색합니다" IsChecked="True" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                            <CheckBox Content="list_directory - 목록을 봅니다" IsChecked="True" Foreground="{StaticResource TextMain}" />
                        </StackPanel>
                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="Allowlist Only" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="12" />
                            <CheckBox DockPanel.Dock="Right" IsChecked="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <views:ChatPanel x:Name="ChatPanelView" Grid.Column="1" />

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="상태 패널" Style="{StaticResource PanelHeader}" />
                        <Button DockPanel.Dock="Right" Content="비우기" Width="52" Height="24" Padding="0" FontSize="11" Click="ClearSidePanel_OnClick" />
                    </DockPanel>
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Verify">
                            <views:VerificationPanel x:Name="VerificationPanelView" />
                        </TabItem>
                        <TabItem Header="Plan">
                            <views:PlanPanel x:Name="PlanPanelView" />
                        </TabItem>
                        <TabItem Header="Memory">
                            <views:MemoryPanel x:Name="MemoryPanelView" />
                        </TabItem>
                        <TabItem Header="Git">
                            <views:GitPanel x:Name="GitPanelView" />
                        </TabItem>
                        <TabItem Header="Run">
                            <ListBox ItemsSource="{Binding RunSteps}" FontSize="12" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CreatedAtText}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,7,8,0" />
                                            <Grid Grid.Column="1">
                                                <Border Width="2"
                                                        Background="#263342"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,-10" />
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Fill="{Binding AccentBrush}"
                                                         Stroke="#0A1017"
                                                         StrokeThickness="2"
                                                         VerticalAlignment="Top"
                                                         Margin="0,9,0,0" />
                                            </Grid>
                                            <Border Grid.Column="2"
                                                    Background="#0E151E"
                                                    BorderBrush="{Binding AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,5">
                                                        <Border DockPanel.Dock="Right"
                                                                Background="{Binding BadgeBackground}"
                                                                BorderBrush="{Binding AccentBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding TimelineLabel}"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMain}"
                                                                   TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TimelineDetail}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="작업 로그">
                            <ListBox ItemsSource="{Binding Logs}" FontSize="12" Padding="6,0,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="4,0,0,7" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="변경 Preview">
                            <views:FileChangeReviewPanel x:Name="FileChangeReviewPanelView" />
                        </TabItem>
                    </TabControl>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Border Background="#0B2A4A" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock Text="전체" Foreground="#93C5FD" FontSize="11" />
                        </Border>
                        <Border Background="#062B1A" BorderBrush="#15803D" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock Text="SUCCESS" Foreground="{StaticResource Success}" FontSize="11" />
                        </Border>
                        <Border Background="#331D03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock Text="WARNING" Foreground="{StaticResource Warning}" FontSize="11" />
                        </Border>
                        <Border Background="#3A1111" BorderBrush="#B91C1C" BorderThickness="1" CornerRadius="4" Padding="7,3">
                            <TextBlock Text="ERROR" Foreground="{StaticResource Danger}" FontSize="11" />
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Background="#0B1118">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Ellipse Width="9" Height="9" Fill="{StaticResource Success}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" FontSize="12" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding UsageText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
            <TextBlock Grid.Column="2" Text="{Binding Model, StringFormat=Model: {0}}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
            <TextBlock Grid.Column="3" Text="{Binding Provider, StringFormat=Provider: {0}}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
            <TextBlock Grid.Column="4" Text="v0.2.0" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
        </Grid>
    </Grid>
</Window>
